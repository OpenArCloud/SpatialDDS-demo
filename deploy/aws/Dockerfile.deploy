# Single-image, multiple-entrypoint container for the SpatialDDS demo
# stack. One image runs every role we need — web bridge, fusion service,
# synthetic publisher, MCAP recorder, MQTT bridge — selected by command.
#
# Base: the same prebuilt CycloneDDS+Python image the rest of the repo
# uses, so we don't have to rebuild the C library and idlc on every
# deploy. (python:3.11-slim does not ship the cyclonedds runtime.)
#
# 11.0.1, not 0.10.5: the typed wire needs an idlc that can emit the spec's
# `global` and `from` field names as valid Python. deploy.sh builds this tag
# locally before invoking CDK, so the deploy does not depend on the registry
# copy; see scripts/publish_base_image.sh for publishing it.
# ----------------------------------------------------------------------
# Stage 1: the Cesium AR bundle.
#
# Vite bakes its `VITE_*` env into the bundle at build time, so anything the
# browser needs has to be decided here rather than at run time. The bridge URL
# is deliberately *not* set: the app falls back to its own origin, which is
# correct for a deployment where one process serves both the bundle and the
# API behind one load balancer.
#
# The Ion token is a build arg because it is a client-side credential that
# ends up in the bundle either way. Without it the app still runs — it just
# shows the plain globe instead of photorealistic tiles, which the UI already
# has a toggle for. Scope the token to this deployment's domains in the Ion
# console rather than treating it as a secret.
# ----------------------------------------------------------------------
FROM node:20-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
ARG VITE_CESIUM_ION_TOKEN=""
ARG VITE_CESIUM_ION_ASSET_ID=""
ENV VITE_CESIUM_ION_TOKEN=$VITE_CESIUM_ION_TOKEN
ENV VITE_CESIUM_ION_ASSET_ID=$VITE_CESIUM_ION_ASSET_ID
# `--base=/ar/` because the bridge mounts this bundle at /ar, not at the site
# root. Vite writes absolute asset URLs from `base`; left at the default the
# HTML loads and every asset 404s, which renders as a blank page with a
# working page source — the failure mode that looks like "Cesium is broken".
# `main.ts` already reads `import.meta.env.BASE_URL` for CESIUM_BASE_URL, so
# Cesium's own workers and assets follow the same base.
# One variable drives both Vite's `base` and the Cesium asset define — see
# web/vite.config.ts for why they cannot be set independently.
ENV VITE_BASE_PATH=/ar/
RUN npm run build


FROM ghcr.io/openarcloud/cyclonedds-python-base:11.0.1-ubuntu22.04

# ----------------------------------------------------------------------
# Bridge + demo Python deps. Installed BEFORE the source COPY so dep
# churn doesn't bust the image cache on every code change.
# ----------------------------------------------------------------------
WORKDIR /app
COPY requirements.txt /app/
COPY bridges/requirements.txt /app/bridges/
COPY bridges/mqtt_bridge/requirements.txt /app/bridges/mqtt_bridge/
COPY bridges/web_bridge/requirements.txt /app/bridges/web_bridge/
RUN python3 -m pip install --no-cache-dir \
    -r /app/requirements.txt \
    -r /app/bridges/requirements.txt \
    -r /app/bridges/mqtt_bridge/requirements.txt \
    -r /app/bridges/web_bridge/requirements.txt \
    boto3                                  # for future S3 MCAP upload

# Loopback-only CycloneDDS config (Fargate-style: all containers share
# the same network namespace, so we never want inter-task multicast).
COPY deploy/aws/cyclonedds.xml /etc/cyclonedds.xml
ENV CYCLONEDDS_URI=file:///etc/cyclonedds.xml

# Application source. Copy as the last layer so iterating on Python code
# keeps reusing the deps layer above.
COPY . /app/
ENV PYTHONPATH=/app

# The built AR bundle, served by the bridge at /ar. Copied after the source
# so a Python-only change does not rebuild it.
COPY --from=web /web/dist /app/web/dist
ENV SPATIALDDS_BRIDGE_AR_DIR=/app/web/dist

# Sensible defaults; per-container overrides (command, port mapping)
# come from docker-compose / the CDK stack.
ENV SPATIALDDS_DDS_DOMAIN=0
ENV WEB_BRIDGE_PORT=8088

# Default command runs the web bridge (the only container that listens
# on a port). Other containers in the task override this.
EXPOSE 8088
CMD ["python3", "-m", "bridges.web_bridge", "--port", "8088", "--domain", "0"]
