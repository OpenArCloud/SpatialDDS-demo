# Configuration for the AWS Fargate deployment.
#
# Copy this file to config.yaml and edit; deploy.sh and destroy.sh both
# load deploy/aws/config.yaml unless you pass a different path.

# ── Required ───────────────────────────────────────────────────────────
aws_region: us-east-1
stack_name: spatialdds-demo

# ── Task sizing (Fargate vCPU / memory pairs are constrained — see
#    https://docs.aws.amazon.com/AmazonECS/latest/developerguide/task-cpu-memory-error.html
#    for valid combinations) ──────────────────────────────────────────
cpu: 1024            # 1 vCPU total, split across containers by ECS
memory: 2048         # 2 GB total

# ── Features (all optional) ────────────────────────────────────────────
features:
  # ── Which demo this deployment runs ─────────────────────────────────
  # They share one DDS domain, so running both means each one's message
  # window shows the other's traffic — the fusion side publishes
  # detections and entity bindings continuously. Pick one.
  #
  #   fusion_demo: the multi-operator fusion dashboard at /
  #   ar_demo:     the Cesium AR demo at /ar/
  fusion_demo: true
  ar_demo: false

  # Synthetic Detection3D publisher (fusion demo only). On by default so the dashboard has
  # something to show on first deploy without any data prerequisites.
  synthetic_publisher: true
  synthetic_operators: 3
  synthetic_objects_per_operator: 5
  synthetic_rate_hz: 10

  # MCAP recording. v0 writes inside the task only — S3 rotation/upload
  # is a follow-on. Leave off unless you specifically want to test the
  # recorder runs alongside the other containers.
  recording: false
  s3_bucket_name: ""             # empty → CDK auto-generates a unique name
  recording_duration_s: 600

  # Custom domain / HTTPS — not yet wired by deploy.sh. Set these and
  # extend spatialdds_stack.py to issue an ACM cert + Route53 record
  # when you're ready for production.
  custom_domain: ""              # e.g., demo.spatialdds.org
  hosted_zone_id: ""             # the Route53 zone ID

# ── AR demo (optional; the defaults describe the bundled Austin mock) ──
# Which place the mock VPS claims to cover, and which catalogue it serves.
# Point these at a real map's location when swapping the mock for a real VPS.
ar_demo:
  vps_service_id: "svc:vps:demo/austin-downtown"
  vps_service_name: "MockVPS-Austin"
  coverage_bbox: "-97.75,30.27,-97.72,30.29"    # west,south,east,north
  map_fqn: "map/austin"
  map_id: "austin-map"
  catalog_seed: "bridges/web_bridge/tests/catalog_seed_austin.json"

  # Cesium Ion, for photorealistic 3D tiles. Optional — without these the
  # demo uses OpenStreetMap imagery and hides the tiles toggle.
  #
  # Vite bakes these into the bundle at build time, so they are served to
  # every visitor. That is normal for a client-side map credential, but it
  # means: use a token scoped to this deployment's hostname in the Ion
  # console, not a personal one. (A developer's token leaking here through
  # web/.env.local is why .dockerignore now excludes that file.)
  cesium_ion_token: ""
  cesium_ion_asset_id: ""       # e.g. 2275207 for Google Photorealistic 3D Tiles

# ── Sharing a DDS bus with another deployment (optional) ───────────────
# By default this stack makes its own VPC and its task talks to itself over
# the task's network namespace. To put it on a bus that spans more than
# itself — an OpenVPS instance running its own SpatialDDS participants, for
# example — three things have to line up:
#
#   1. A network path. Name an existing VPC below and the task is placed
#      there, beside the peer, with no VPC peering to arrange and no second
#      NAT gateway to pay for. Leave it empty to keep the private VPC.
#   2. Unicast peers. A VPC carries no multicast, so RTPS discovery must be
#      told where to look. Cyclone peer syntax, space- or comma-separated.
#      The peer needs this stack's address in *its* list too, or discovery
#      completes one way and no sample is ever exchanged.
#   3. A way in. RTPS is UDP from 7400 for domain 0, and the peer's security
#      group has to allow this task. Two ways:
#
#      * `security_group_ids` — join the peer's own group. openvps-deploy's
#        RTPS rules are sourced from its own security group, written for two
#        GPU hosts finding each other; a task inside that group is covered by
#        them unchanged. Nothing to alter in that repo, and `DdsPeers` and
#        `AttachElasticIp` there are already stack parameters, so its side is
#        deploy-time configuration rather than a code change.
#      * `dds_peer_cidr` — open a CIDR on this task's own group instead, for a
#        peer whose group you cannot join.
#
#      Naming peers with neither is refused at synth, rather than deploying
#      something whose discovery completes one way and exchanges nothing.
#
# vpc_id: "vpc-0123456789abcdef0"        # place the task beside the peer
# dds_peers: "udp/10.0.1.42"             # the peer's private IP
# security_group_ids: "sg-0123456789abcdef0"   # the peer's security group
# dds_peer_cidr: "10.0.0.0/16"           # alternative to the line above
