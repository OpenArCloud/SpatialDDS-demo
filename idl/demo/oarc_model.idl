// SPDX-License-Identifier: MIT
//
// Open World Model — a demo-local world-model layer.
//
// **Demo-local and non-normative.** This is not SpatialDDS 1.7 and has no
// registry row. It exists so the shape can be argued against a running demo
// before anything is proposed for the spec. See the OWM proposal sketch
// (`owm-proposal-sketch.md`, §5.1) for the design and §10 for the guard
// rails; SPEC_COMPLIANCE lists it as demo-local, candidate for
// `spatial.model`.
//
// The layer answers a question the catalogue cannot: the catalogue says what
// content exists and where you would find it, one row per thing. A model says
// what is *there* — entities with identity, poses, types and relationships —
// and points at catalogue content when an entity happens to have an asset.
// One duck.glb in the catalogue, three ducks in the world.
//
// Almost everything here is borrowed. Frames, poses, extents, key/value bags
// and time are all SpatialDDS types; only the join is new.

#ifndef OARC_MODEL_INCLUDED
#define OARC_MODEL_INCLUDED

#ifndef SPATIAL_CORE_INCLUDED
#define SPATIAL_CORE_INCLUDED
#include "core.idl"
#endif

#ifndef SPATIAL_COMMON_TYPES_INCLUDED
#define SPATIAL_COMMON_TYPES_INCLUDED
#include "types.idl"
#endif

module oarc_model {

  const string MODULE_ID = "oarc.model/0.1";

  typedef builtin::Time Time;

  // How fast a thing is expected to change. Carried in Part 1 but
  // informational: per-layer topic splitting waits for a FAST tier.
  enum ModelLayer { @value(0) STATIC, @value(1) SLOW, @value(2) FAST };

  // Where the claim comes from. A surveyed bollard, a bollard someone typed
  // in, and a bollard inferred from a point cloud are different assertions,
  // and a consumer is entitled to treat them differently.
  enum Basis { @value(0) OBSERVED, @value(1) DECLARED,
               @value(2) AUTHORED, @value(3) DERIVED };

  // UNOBSERVED is a state, not a removal: "it was here and nothing can
  // currently see it" is different from "it is gone".
  enum LifecycleState { @value(0) ACTIVE, @value(1) UNOBSERVED,
                        @value(2) RETIRED, @value(3) SUPERSEDED };

  @extensibility(APPENDABLE) struct Entity {
    @key string entity_id;                  // model-minted UUID
    Basis basis;
    sequence<string, 4> type_uris;          // borrowed vocabularies only
    ModelLayer layer;
    spatial::common::FrameRef frame_ref;

    boolean has_pose;
    spatial::core::PoseSE3 pose;
    boolean has_extent;
    spatial::core::Aabb3 extent;

    sequence<spatial::common::KV, 32> properties;     // namespaced
    sequence<spatial::common::KV, 8>  external_refs;  // e.g. "gers" -> id
    // References into content this entity is rendered from. Part 1 uses
    // `catalog:<content_id>`; a spatialdds:// manifest URI is the eventual
    // form. Many entities may share one reference -- that asset-vs-instance
    // split is the point of the layer.
    sequence<string, 8> content_refs;

    LifecycleState state;
    string state_reason;
    string source_id;
    Time   stamp;
  };

  // Relationships are their own keyed instances, so an edge can be disposed
  // without disposing either end. It cannot *retire* independently, or at
  // all: there is no LifecycleState here, so an edge can only stop being
  // there -- it has no way to say why it went, and no `basis` to say how the
  // claim was arrived at. Both are Entity's, and both are missing here.
  // Under-specified relative to Entity, twice over; an R3 question, not a
  // demo one.
  @extensibility(APPENDABLE) struct Relationship {
    @key string rel_id;
    string kind;                  // "contains" | "adjacent" | "bound-to" | URI
    string from_entity_id;
    string to_entity_id;
    sequence<spatial::common::KV, 16> properties;
    string source_id;
    Time   stamp;
  };

  // A request to the authority that owns an entity -- not a claim about the
  // world, which is why it is a separate type on a separate topic rather than
  // an Entity with state=RETIRED written by whoever felt like it.
  //
  // Retirement cannot be published around the owner. TRANSIENT_LOCAL history
  // is writer-scoped: a tombstone written by a short-lived operator tool dies
  // with the tool, and the next reader to join is handed the owner's still
  // latched ACTIVE sample. So the tool asks and the owner acts, which is also
  // the only way the dispose sticks. See SPEC_COMPLIANCE, "Two writers, one
  // instance", where the same problem was measured for moves.
  //
  // VOLATILE on purpose: a command is an event, not state, and a late joiner
  // has no business replaying yesterday's retirements.
  //
  // Keyed on command_id, which was not the first design. Unkeyed looked more
  // honest -- there is no instance here whose lifetime means anything -- and
  // it crashed the service. When an operator tool exits, its writer
  // unregisters and the middleware delivers an invalid sample carrying only a
  // key blob; deserializing the key of an unkeyed type reads a length prefix
  // out of an empty buffer and raises. The reader cannot filter what it
  // cannot decode, so the fix is at the type: give each request an identity
  // the middleware can name. It costs nothing -- VOLATILE keeps no history
  // per instance -- and a request id is a thing a request should have anyway.
  @extensibility(APPENDABLE) struct ModelCommand {
    @key string command_id;
    string verb;             // "retire" | "move" | "dispose_edge" | "restore"

    // The thing being acted on, entity or relationship. One field rather than
    // an entity_id beside a rel_id, because the verb already determines which
    // kind it names and a field that is empty for every other verb is a worse
    // lie than a general one. Ids say what they are -- `ent:` or `rel:` -- so
    // nothing has to be guessed. Ignored by "restore".
    //
    // Named entity_id until Part 3, when "dispose_edge" arrived and made that
    // name false for one of the verbs.
    string subject_id;
    string reason;           // why, carried into state_reason by "retire"
    string requester_id;     // who asked, for the log
    // Guarded because only "move" carries one, and a pose field that is
    // sometimes meaningless is worse than one that says when it is.
    boolean has_pose;
    spatial::core::PoseSE3 pose;
    Time   stamp;
  };

};

#endif // OARC_MODEL_INCLUDED
