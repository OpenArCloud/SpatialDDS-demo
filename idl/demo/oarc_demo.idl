// SPDX-License-Identifier: MIT
// Demo-owned types for flows SpatialDDS 1.7 has no struct for.
//
// Everything here is a gap in the spec as far as this demo is concerned; each
// struct is WG input. Spec types are used wherever a spec type exists — this
// module exists so that no opaque JSON has to ride the bus.

#ifndef OARC_DEMO_INCLUDED
#define OARC_DEMO_INCLUDED

#ifndef SPATIAL_CORE_INCLUDED
#define SPATIAL_CORE_INCLUDED
#include "core.idl"
#endif

#ifndef SPATIAL_SENSING_COMMON_INCLUDED
#define SPATIAL_SENSING_COMMON_INCLUDED
#include "common.idl"
#endif

#include "vision.idl"
#include "argeo.idl"
#include "discovery.idl"
#include "semantics.idl"

module oarc_demo {

  const string MODULE_ID = "oarc.demo/1.7";

  typedef builtin::Time Time;

  // --- Bootstrap query/response ------------------------------------------
  // 1.7 defines the bootstrap *manifest* (5.x) and its well-known HTTPS path,
  // but no on-bus query/response pair. The demo needs one to show cold start
  // without HTTP.
  @extensibility(APPENDABLE) struct BootstrapQuery {
    @key string client_id;
    string client_kind;
    sequence<string, 16> capabilities;
    string location_hint;
    Time stamp;
  };

  @extensibility(APPENDABLE) struct BootstrapResponse {
    @key string client_id;
    string spatialdds_bootstrap;
    int32  dds_domain;
    string cyclonedds_profile;
    sequence<string, 16> manifest_uris;
    uint32 ttl_sec;
    Time   stamp;
  };

  // --- VPS localization ---------------------------------------------------
  // 3.3.2 registers the topic type `vps_query` ("VPS localization request —
  // query image/features + hints") but the IDL defines no struct for it, so
  // the request shape is demo-owned. The *response* needs no new payload type
  // — argeo::NodeGeo is exactly right — but the request/response correlation
  // and quality reporting around it have no spec home either.
  @extensibility(APPENDABLE) struct QualityRequirements {
    double max_rmse_m;
    double min_confidence;
  };

  @extensibility(APPENDABLE) struct LocalizeQuality {
    boolean success;
    double  confidence;
    double  rmse_m;
  };

  @extensibility(APPENDABLE) struct VpsRequest {
    @key string request_id;            // correlates the reply
    string service_id;                 // which VPS is being asked
    spatial::common::FrameRef client_frame_ref;
    spatial::core::GeoPose prior_geopose;
    spatial::sensing::vision::VisionFrame vision_frame;
    QualityRequirements quality_requirements;
    Time stamp;
  };

  @extensibility(APPENDABLE) struct VpsResponse {
    @key string request_id;            // mirrors VpsRequest.request_id
    string service_id;
    spatial::argeo::NodeGeo node_geo;  // the spec type; the pose itself
    LocalizeQuality quality;
    Time stamp;
  };

  // --- Content catalogue ---------------------------------------------------
  // The demo's catalogue is a demo protocol. 1.7 has ContentAnnounce for
  // advertising content, but no request/response pair for querying a
  // catalogue by area, and no per-result row type.
  @extensibility(APPENDABLE) struct CatalogFilter {
    sequence<string, 16> kind_in;      // "mesh", "poi", "overlay", ...
  };

  @extensibility(APPENDABLE) struct CatalogQuery {
    @key string query_id;
    string reply_topic;
    sequence<spatial::disco::CoverageElement, 4> coverage;
    spatial::common::FrameRef coverage_frame_ref;
    boolean has_filter;
    CatalogFilter filter;
    uint32 limit;
    string page_token;
    Time   stamp;
    uint32 ttl_sec;
  };

  @extensibility(APPENDABLE) struct CatalogEntry {
    string content_id;
    string kind;
    string name;
    sequence<spatial::disco::CoverageElement, 4> coverage;
    spatial::common::FrameRef frame_ref;
    sequence<string, 8> formats;
    uint64 updated_sec;
    string href;
  };

  @extensibility(APPENDABLE) struct CatalogResponse {
    string query_id;                   // mirrors CatalogQuery.query_id
    sequence<CatalogEntry, 256> results;
    string next_page_token;
    Time   stamp;
  };

  // --- Multi-operator fusion ----------------------------------------------
  // spatial::semantics::Detection3D is the right type for a 3D detection, and
  // it is used verbatim below. It carries no **velocity**, though, and this
  // demo's fuser gates association on position *and* velocity and fuses both.
  // rad::RadDetection has velocity and PlannedWaypoint has velocity, but the
  // semantic detection does not.
  //
  // The spec's extension hatch is MetaKV{namespace, json} — a JSON string —
  // and putting JSON back on the bus is the thing this migration exists to
  // stop. So the spec type is composed rather than replaced or smuggled into:
  // a conformant consumer can lift `detection` out untouched.
  @extensibility(APPENDABLE) struct DetectionWithVelocity {
    spatial::semantics::Detection3D detection;   // the spec type, verbatim
    boolean has_velocity;
    spatial::common::Vec3 velocity;              // m/s, the gap
    string source_modality;                      // "det3d", "radar", ...
  };

  @extensibility(APPENDABLE) struct OperatorDetectionSet {
    @key string set_id;
    string source_operator;                      // the interoperability contract
    spatial::common::FrameRef frame_ref;
    sequence<DetectionWithVelocity, 256> dets;
    uint64 frame_seq;
    Time   stamp;
  };

  // Fused output. 1.7 has no fused-track type: slam_frontend::Tracklet is
  // feature-level and vision::Track2D is per-image, neither is a
  // multi-operator object track.
  @extensibility(APPENDABLE) struct FusedTrack {
    @key string track_id;
    spatial::common::Vec3 position;
    spatial::common::Vec3 velocity;
    double position_uncertainty;
    string object_class;
    double confidence;
    sequence<string, 16> source_operators;
    sequence<string, 16> source_modalities;
    uint32 source_count;
    double track_age;
    Time   stamp;
  };

  @extensibility(APPENDABLE) struct FusedTrackSet {
    @key string source_operator;                 // always "platform"
    sequence<FusedTrack, 256> tracks;
    Time   stamp;
  };

  @extensibility(APPENDABLE) struct OperatorTrackCount {
    string operator_id;
    uint32 track_count;
  };

  @extensibility(APPENDABLE) struct FusionCoverage {
    @key string source_operator;                 // always "platform"
    uint32 track_count;
    uint32 multi_source_count;
    double multi_source_pct;
    uint32 best_single_operator_count;
    double coverage_improvement;
    uint32 best_av_operator_count;
    double coverage_improvement_excl_infra;
    sequence<OperatorTrackCount, 16> per_operator_track_count;
    Time   stamp;
  };

  // --- 2D detections -------------------------------------------------------
  // 1.7 has semantics::Detection3D for 3D boxes and nothing for 2D ones.
  // vision::VisionDetections carries keypoints and 2D *tracks*, not labelled
  // boxes, and `seg_mask` is masks — so the most common camera perception
  // output in the world, a box with a class and a score, has no type.
  //
  // Mirrors Detection3D's field naming so the two read alike.
  @extensibility(APPENDABLE) struct BBox2D {
    float x;                             // top-left, pixels
    float y;
    float w;
    float h;
  };

  @extensibility(APPENDABLE) struct Detection2D {
    string  det_id;
    BBox2D  bbox;
    string  class_id;
    float   score;
  };

  @extensibility(APPENDABLE) struct Detection2DSet {
    @key string stream_id;               // which camera
    uint64      frame_seq;
    sequence<Detection2D, 256> dets;
    Time        stamp;
    string      source_id;
  };

  // --- Blob transfer -------------------------------------------------------
  // spatial::core::BlobChunk is the spec's mechanism for moving bytes, and it
  // is unusable from cyclonedds-python: its `sequence<uint8, 262144>` exceeds
  // the binding's hard 65535 sequence bound, so building a Topic for it
  // raises before a single byte is written. Since BlobChunk is the only type
  // in 1.7 that carries bytes at all, the reference Python binding cannot
  // move sensor data on the bus.
  //
  // This is byte-identical in semantics — same composite key, same crc32,
  // same chunking contract — at a bound the binding can encode. It is a
  // toolchain workaround, not a disagreement with the spec: if either the
  // spec's bound or the binding's limit moves, this type goes away and
  // spatial::core::BlobChunk is used directly.
  @extensibility(APPENDABLE) struct BlobChunk {
    @key string blob_id;                 // which blob
    @key uint32 index;                   // chunk index (0..total_chunks-1)
    uint32 total_chunks;
    uint32 crc32;                        // CRC32 over `data`
    sequence<uint8, 65535> data;         // <=64 KiB, the binding's ceiling
  };

};

#endif // OARC_DEMO_INCLUDED
