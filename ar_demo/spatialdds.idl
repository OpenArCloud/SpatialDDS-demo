// SPDX-License-Identifier: MIT
// SpatialDDS Convenience Aggregator (v1.8)
//
// The official v1.8 IDL is the copy the SDK ships (spatialdds[dds], at the
// spec's v1.8 tag); `python3 -c 'from spatialdds.server import pin;
// print(pin.IDL_DIR)'` prints where. Compile with `-I` pointed there. Until the
// SDK adoption this repository vendored it as idl/v1.8. This wrapper adds NO
// types of its own -- it only #includes the profile files so build scripts
// that expect a single IDL entry point keep working.
//
// Include-guard contract: types.idl self-guards, but core.idl and common.idl
// do NOT guard their own bodies — each *consumer* wraps the include in
// `#ifndef SPATIAL_CORE_INCLUDED / #define ... / #endif` (see discovery.idl).
// So a direct include of core.idl or common.idl must set the same sentinel,
// or the next profile file pulls the body in a second time and idlc fails with
// "Declaration 'MODULE_ID' collides with an earlier declaration".

#include "types.idl"

#ifndef SPATIAL_CORE_INCLUDED
#define SPATIAL_CORE_INCLUDED
#include "core.idl"
#endif

#ifndef SPATIAL_SENSING_COMMON_INCLUDED
#define SPATIAL_SENSING_COMMON_INCLUDED
#include "common.idl"
#endif

#include "discovery.idl"
#include "anchors.idl"
#include "vision.idl"
#include "vio.idl"
#include "slam_frontend.idl"
#include "argeo.idl"
#include "lidar.idl"
#include "rad.idl"
#include "semantics.idl"
#include "events.idl"
#include "mapping.idl"
